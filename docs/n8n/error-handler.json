{
  "id": "lendloop-error-handler",
  "name": "LendLoop - Error handler",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "c9e3a2f6-0003-4000-8000-000000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\nconst d = $input.first().json;\nconst name = d.workflow?.name ?? \"unknown workflow\";\nconst message = d.execution?.error?.message ?? \"unknown error\";\nconsole.error(`[error] ${name}: ${message}`);\n// Sign the exact bytes the HTTP node sends; Convex verifies the HMAC.\nconst body = JSON.stringify({\n  type: \"workflow-failed\",\n  detail: `${name}: ${message}`,\n});\nconst ts = String(Math.floor(Date.now() / 1000));\nconst sig =\n  \"v1=\" +\n  crypto\n    .createHmac(\"sha256\", $env.N8N_API_SECRET)\n    .update(`${ts}.${body}`)\n    .digest(\"hex\");\nreturn [{ json: { body, ts, sig } }];"
      },
      "id": "c9e3a2f6-0003-4000-8000-000000000002",
      "name": "Log failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/loan-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.N8N_API_SECRET }}"
            },
            { "name": "X-Lendloop-Timestamp", "value": "={{ $json.ts }}" },
            { "name": "X-Lendloop-Signature", "value": "={{ $json.sig }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "c9e3a2f6-0003-4000-8000-000000000003",
      "name": "Record failure in LendLoop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Log failure", "type": "main", "index": 0 }]]
    },
    "Log failure": {
      "main": [
        [{ "node": "Record failure in LendLoop", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
