# Copy to .env.local (gitignored) and fill in, then run `pnpm convex:sync-env`.
# Docker reads it via `env_file`; the sync pushes the same values to the Convex
# backend (webhook signing + HTTP endpoint auth), which cannot read .env.local.

# URL n8n listens on for loan events (Convex -> n8n)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lendloop-loan-events

# Shared secret used to HMAC-sign webhook payloads (Convex -> n8n)
N8N_WEBHOOK_SECRET=

# Bearer secret n8n must send to the Convex HTTP endpoints
N8N_API_SECRET=
