# Copy to .env (gitignored) and fill in. Everything you edit lives here.
# Read natively by Next.js, docker compose (`env_file`), and the Convex CLI
# (`npx convex env set --from-file .env --force`). See docs/n8n/README.md.
#
# (.env.local is machine-written state owned by `npx convex dev` -- leave it.)

# --- App routes ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tools
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/tools

# Absolute URL the site is deployed on (canonical/OG links). Local default is
# fine for development.
NEXT_PUBLIC_SITE_URL=

# --- Clerk (from your Clerk dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Issuer domain of the "convex" JWT template in Clerk. Only read by the Convex
# backend, so push it with `npx convex env set --from-file .env --force`.
CLERK_JWT_ISSUER_DOMAIN=

# --- n8n integration ---
# URL n8n listens on for loan events (Convex -> n8n)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lendloop-loan-events

# Shared secret used to HMAC-sign webhook payloads (Convex -> n8n)
N8N_WEBHOOK_SECRET=

# Bearer secret n8n must send to the Convex HTTP endpoints
N8N_API_SECRET=
